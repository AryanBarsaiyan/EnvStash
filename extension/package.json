{
  "name": "envstash",
  "displayName": "EnvStash",
  "description": "Secure per-project environment variable manager with runbooks — by Aryan Barsaiyan",
  "version": "1.2.0",
  "publisher": "AryanBarsaiyan",
  "repository": {
    "type": "git",
    "url": "https://github.com/AryanBarsaiyan/EnvStash.git"
  },
  "icon": "icon.png",
  "author": {
    "name": "Aryan Barsaiyan"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "envstash",
          "title": "EnvStash",
          "icon": "$(lock)"
        }
      ]
    },
    "views": {
      "envstash": [
        {
          "type": "webview",
          "id": "envstash.panel",
          "name": "EnvStash",
          "icon": "$(lock)"
        }
      ]
    },
    "commands": [
      {
        "command": "envstash.open",
        "title": "EnvStash: Open Panel"
      },
      {
        "command": "envstash.switchEnvironment",
        "title": "EnvStash: Switch Environment"
      },
      {
        "command": "envstash.exportAll",
        "title": "EnvStash: Export All Data"
      },
      {
        "command": "envstash.importAll",
        "title": "EnvStash: Import Data"
      }
    ],
    "configuration": {
      "title": "EnvStash",
      "properties": {
        "envstash.clipboardClearSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 3600,
          "description": "Seconds after which a copied variable value is cleared from the clipboard. Set to 0 to never clear it."
        },
        "envstash.autoHideSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 3600,
          "description": "Seconds after which revealed variable values are hidden again. Set to 0 to keep them visible. Takes effect when the EnvStash panel is reloaded."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test \"test/**/*.test.js\"",
    "test:unit": "npm run compile && node --test \"test/unit/*.test.js\"",
    "test:feature": "npm run compile && node --test \"test/feature/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.0.0"
  }
}
